---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hawk from '../components/Hawk.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';
import { crafts, impact } from '../data/resume';
import { embedUrl, roman, timecode } from '../lib/video';
import { getProjects } from '../lib/work';
import loopPoster from '../assets/reel/loop-poster.jpg';
import portrait from '../assets/about/chris-shinjuku.jpg';
import neon from '../assets/backdrops/neon-red.jpg';

const projects = await getProjects();
// One wide feature plus a row of three.
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const reel = site.reel;
---

<Base>
  <!-- ░░ Hero: the reel is the headline ░░ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        src={reel.loop}
        poster={loopPoster.src}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        data-hero-video
      >
      </video>
      <div class="hero__shade"></div>
    </div>

    <div class="container hero__inner">
      <Hawk class="hero__hawk" draw delay={0.2} />

      <div class="hero__copy">
        <p class="kicker kicker--acid hero__kicker">{site.role} — {site.location}</p>
        <h1 id="hero-title" class="display hero__title">
          I help ideas <span class="hero__flight bl">take flight.</span>
        </h1>
        <p class="lede hero__lede">
          Animation, live-action production and post — fifteen-plus years of turning briefs into films people
          actually watch.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--acid" href="#work">See the work <Icon name="arrow-down" /></a>
          <button
            class="btn hero__reel"
            type="button"
            data-theater
            data-src={embedUrl(reel.video)}
            data-provider={reel.video.provider}
            data-title={`${reel.title} ${reel.year}`}
          >
            <Icon name="play" /> Play reel with sound
            <span class="mono muted">{timecode(reel.video.duration)}</span>
          </button>
        </div>
      </div>

      <div class="hero__foot mono" aria-hidden="true">
        <span>Reel {roman(reel.year)}</span>
        <span class="hero__tc" data-hero-tc>TC 00:00:00:00</span>
        <span class="hero__scroll">Scroll <Icon name="arrow-down" /></span>
      </div>
    </div>
  </section>

  <!-- ░░ Selected work — straight after the reel ░░ -->
  <section id="work" class="section work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="kicker" data-reveal>Selected work · {roman(featured.length)} of {roman(projects.length)}</p>
        <h2 id="work-title" class="h1" data-reveal style="--i:1">
          Films, animation <br />& everything between.
        </h2>
        <a class="btn section-head__cta" href="/work" data-reveal style="--i:2">
          All {projects.length} projects <Icon name="arrow" />
        </a>
      </header>

      <div class="work__grid">
        {featured.map((p, i) => <ProjectCard project={p} index={i} size={i === 0 ? 'feature' : 'default'} eager={i === 0} />)}
      </div>

      <p class="work__more" data-reveal>
        <a href="/work" class="work__more-link">
          <Icon name="manicule" />
          <span class="link-line">Browse the full library</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ░░ Crafts ░░ -->
  <section class="section crafts" aria-labelledby="crafts-title">
    <div class="container">
      <header class="section-head section-head--split">
        <p class="kicker" data-reveal>What I bring</p>
        <h2 id="crafts-title" class="h1" data-reveal style="--i:1">One person, the whole pipeline.</h2>
      </header>
      <ol class="crafts__list" role="list">
        {
          crafts.map((c, i) => (
            <li class="craft" data-reveal style={`--i:${i}`}>
              <span class="craft__num blackletter numeral">{roman(i + 1)}</span>
              <h3 class="craft__title">{c.title}</h3>
              <p class="craft__body">{c.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ░░ Impact ░░ -->
  <section class="impact" aria-label="Impact">
    <div class="container impact__grid">
      {
        impact.map((m, i) => (
          <div class="metric" data-reveal style={`--i:${i}`}>
            <p class="metric__value">{m.value}</p>
            <p class="metric__label">{m.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ░░ About teaser ░░ -->
  <section class="section meet" aria-labelledby="meet-title">
    <div class="backdrop" aria-hidden="true">
      <Image class="backdrop__img" src={neon} alt="" widths={[800, 1400]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container meet__grid">
      <figure class="meet__photo" data-reveal>
        <Image
          src={portrait}
          alt="Chris Hawk in a red beanie and denim jacket, arms crossed and smiling under neon signs in Shinjuku, Tokyo."
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 900px) 40vw, 90vw"
          loading="lazy"
        />
        <figcaption class="mono">Shinjuku, Tokyo</figcaption>
      </figure>
      <div class="meet__copy">
        <p class="kicker kicker--acid" data-reveal>Hello</p>
        <h2 id="meet-title" class="h1" data-reveal style="--i:1">I'm Chris — a motion designer who also runs the set.</h2>
        <p class="lede" data-reveal style="--i:2">
          For fifteen-plus years I've planned shoots, rigged characters, cut, graded and shipped — for an insurer's
          100-foot conference screens, an agency's clients and 200,000 newsletter readers. I care about the
          story first and the pixels right after.
        </p>
        <div class="meet__ctas" data-reveal style="--i:3">
          <a class="btn btn--acid" href="/about">More about me <Icon name="arrow" /></a>
          <a class="btn" href={site.resumeUrl} target="_blank" rel="noopener">Résumé <Icon name="arrow-up-right" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ──────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) contrast(1.08) brightness(0.62);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--ink) 0%, rgb(11 10 9 / 0.35) 45%, rgb(11 10 9 / 0.55) 100%),
      linear-gradient(to right, rgb(11 10 9 / 0.75) 0%, transparent 70%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    grid-template-rows: 1fr auto;
    align-items: end;
    gap: 2rem clamp(1rem, 4vw, 4rem);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 1.5rem;
  }
  .hero__copy {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(1rem, 4vh, 3rem);
  }
  .hero__hawk {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    justify-self: center;
    width: auto;
    height: min(66svh, 38rem);
    max-width: 100%;
    filter: drop-shadow(0 0 40px rgb(228 240 74 / 0.16));
  }
  .hero__title {
    max-width: 10ch;
    animation: rise 1.1s var(--ease-out) 0.15s both;
  }
  .hero__flight {
    display: inline-block;
    color: var(--acid);
  }
  .hero__kicker {
    animation: rise 1s var(--ease-out) both;
  }
  .hero__lede {
    animation: rise 1.1s var(--ease-out) 0.3s both;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 1.1s var(--ease-out) 0.45s both;
  }
  .hero__reel {
    background: rgb(11 10 9 / 0.45);
    backdrop-filter: blur(8px);
  }
  .hero__reel :global(.icon--play) {
    color: var(--acid);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  .hero__foot {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-3);
  }
  .hero__tc {
    color: var(--bone-2);
    font-variant-numeric: tabular-nums;
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__scroll :global(svg) {
    animation: nudge 1.8s var(--ease-in-out) infinite;
  }
  @keyframes nudge {
    50% { transform: translateY(4px); }
  }
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }
    .hero__hawk {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      height: min(36svh, 17rem);
      margin-top: 0.5rem;
    }
    .hero__copy {
      grid-row: 2;
      align-self: end;
    }
    .hero__tc {
      display: none;
    }
  }

  /* ── Section heads ─────────────────────────────────── */
  .section-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .section-head .kicker {
    grid-column: 1 / -1;
  }
  .section-head--split {
    grid-template-columns: 1fr;
  }
  .section-head h2 {
    max-width: 16ch;
  }

  /* ── Work ──────────────────────────────────────────── */
  .work {
    padding-top: clamp(4rem, 8vw, 7rem);
  }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  .work__grid > :global(.card--feature) {
    grid-column: 1 / -1;
  }
  .work__more {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: flex;
    justify-content: center;
  }
  .work__more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .work__more-link :global(.icon--manicule) {
    color: var(--acid);
    font-size: 1.2em;
    transition: transform 0.5s var(--ease-out);
  }
  .work__more-link:hover :global(.icon--manicule) {
    transform: translateX(6px);
  }
  @media (max-width: 900px) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 700px) {
    .section-head {
      grid-template-columns: 1fr;
    }
    .section-head__cta {
      justify-self: start;
    }
  }

  /* ── Crafts ────────────────────────────────────────── */
  .crafts {
    border-top: 1px solid var(--line);
  }
  .crafts__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .craft {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.75rem 1.5rem 2rem 0;
  }
  .craft + .craft {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .craft__num {
    font-size: 3rem;
    color: var(--acid);
  }
  .craft__title {
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }
  .craft__body {
    color: var(--bone-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  @media (max-width: 1000px) {
    .crafts__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .craft:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .craft:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .crafts__list {
      grid-template-columns: 1fr;
    }
    .craft + .craft {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  /* ── Impact ────────────────────────────────────────── */
  .impact {
    border-block: 1px solid var(--line);
    background: var(--ink-2);
  }
  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .metric {
    padding: clamp(2rem, 4vw, 3.25rem) 1.5rem;
  }
  .metric + .metric {
    border-left: 1px solid var(--line);
  }
  .metric__value {
    font-size: clamp(2.5rem, 1.5rem + 3.5vw, 4.75rem);
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--acid);
  }
  .metric__label {
    margin-top: 0.75rem;
    max-width: 24ch;
    font-size: var(--fs-sm);
    color: var(--bone-2);
  }
  @media (max-width: 900px) {
    .impact__grid {
      grid-template-columns: 1fr 1fr;
    }
    .metric:nth-child(3) {
      border-left: 0;
    }
    .metric:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 480px) {
    .metric {
      padding-inline: 1rem;
    }
    .metric:first-child,
    .metric:nth-child(3) {
      padding-left: 0;
    }
  }

  /* ── Meet ──────────────────────────────────────────── */
  .meet {
    position: relative;
    isolation: isolate;
  }
  .meet__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .meet__photo {
    position: relative;
  }
  .meet__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line), 0 40px 100px -30px rgb(0 0 0 / 0.8);
  }
  .meet__photo figcaption {
    margin-top: 0.75rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-3);
  }
  .meet__copy {
    display: grid;
    gap: 1.5rem;
  }
  .meet__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 800px) {
    .meet__grid {
      grid-template-columns: 1fr;
    }
    .meet__photo {
      max-width: 26rem;
    }
  }
</style>

<script>
  // Running timecode (HH:MM:SS:FF at 24fps) synced to the hero loop.
  document.addEventListener('astro:page-load', () => {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const tc = document.querySelector<HTMLElement>('[data-hero-tc]');
    if (!video || !tc) return;
    const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
    let raf = 0;
    const draw = () => {
      const t = video.currentTime;
      tc.textContent = `TC 00:${pad(t / 60)}:${pad(t % 60)}:${pad((t % 1) * 24)}`;
      raf = requestAnimationFrame(draw);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) video.pause();
    else raf = requestAnimationFrame(draw);
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  });
</script>

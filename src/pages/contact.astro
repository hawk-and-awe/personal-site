---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hawk from '../components/Hawk.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import neon from '../assets/backdrops/neon-crossing.jpg';
---

<Base title="Contact" description="Hiring, commissioning or just saying hi — get in touch with Chris Hawk." footerCta={false}>
  <section class="contact">
    <div class="backdrop" aria-hidden="true">
      <Image class="backdrop__img" src={neon} alt="" widths={[800, 1400]} sizes="100vw" loading="eager" />
    </div>

    <div class="container contact__grid">
      <div class="contact__intro">
        <Hawk class="contact__hawk" draw delay={0.1} />
        <p class="kicker kicker--acid">Correspondence</p>
        <h1 class="display contact__title">Let's make it <span class="blackletter acid">soar.</span></h1>
        <p class="lede">
          Hiring for a motion or video role, commissioning a film, or just want to talk shop? I read every note.
        </p>

        <div class="direct">
          <p class="kicker">Write directly</p>
          <div class="direct__row">
            <a class="direct__email" href={`mailto:${site.email}`}>{site.email}</a>
            <button class="copy" type="button" data-copy={site.email} aria-live="polite">
              <Icon name="copy" class="copy__i" />
              <Icon name="check" class="copy__ok" />
              <span class="copy__label">Copy</span>
            </button>
          </div>
          <ul class="direct__links" role="list">
            {
              site.socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="link-line">
                    {s.label} <span class="muted">{s.handle}</span>
                  </a>
                </li>
              ))
            }
            <li><a href={site.resumeUrl} target="_blank" rel="noopener" class="link-line">Résumé (PDF)</a></li>
          </ul>
          {
            site.availability.open && (
              <p class="status mono">
                <span class="status__dot" aria-hidden="true" /> {site.availability.label} · {site.location}
              </p>
            )
          }
        </div>
      </div>

      <form class="form" data-contact-form data-endpoint={site.contactFormEndpoint} data-email={site.email} novalidate>
        <p class="kicker">Or send a note</p>
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-org">Company <span class="muted">(optional)</span></label>
          <input id="f-org" name="company" type="text" autocomplete="organization" />
        </div>
        <fieldset class="field">
          <legend>What's this about?</legend>
          <div class="choices">
            {
              ['A full-time role', 'A freelance project', 'Something else'].map((c, i) => (
                <label class="choice">
                  <input type="radio" name="topic" value={c} checked={i === 0} />
                  <span>{c}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="f-msg">Message</label>
          <textarea id="f-msg" name="message" rows="5" required></textarea>
        </div>
        <!-- Honeypot for bots -->
        <input class="visually-hidden" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn--acid form__submit" type="submit">
          <span data-submit-label>Send message</span>
          <Icon name="arrow" />
        </button>
        <p class="form__status" role="status" data-form-status></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .contact__intro {
    display: grid;
    gap: 1.5rem;
  }
  .contact__hawk {
    width: clamp(7rem, 14vw, 10rem);
    height: auto;
    --hawk-fill: rgb(11 10 9 / 0.4);
  }
  .contact__title .blackletter {
    font-size: 1.1em;
  }
  .direct {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .direct__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .direct__email {
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--acid);
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 0.2s, color 0.2s;
  }
  .copy:hover {
    border-color: var(--acid);
  }
  .copy :global(.copy__ok),
  .copy.is-done :global(.copy__i) {
    display: none;
  }
  .copy.is-done :global(.copy__ok) {
    display: block;
    color: var(--acid);
  }
  .direct__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--bone-2);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-2);
  }
  .status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acid);
    animation: beacon 2.4s var(--ease-out) infinite;
  }
  @keyframes beacon {
    0% { box-shadow: 0 0 0 0 rgb(228 240 74 / 0.55); }
    70%, 100% { box-shadow: 0 0 0 9px rgb(228 240 74 / 0); }
  }

  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(19 18 16 / 0.82);
    backdrop-filter: blur(16px);
  }
  .field {
    display: grid;
    gap: 0.45rem;
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .field label,
  .field legend {
    font-size: var(--fs-sm);
    color: var(--bone-2);
    padding: 0;
  }
  .field legend {
    margin-bottom: 0.45rem;
  }
  input:not([type='radio']),
  textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bone);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input:not([type='radio']):focus,
  textarea:focus {
    outline: none;
    border-color: var(--acid);
    box-shadow: 0 0 0 3px var(--acid-dim);
  }
  [aria-invalid='true'] {
    border-color: var(--ember) !important;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .choice {
    position: relative;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .choice span {
    display: inline-flex;
    align-items: center;
    height: 2.4rem;
    padding: 0 0.95rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--bone-2);
    transition: all 0.2s;
  }
  .choice input:checked + span {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--ink);
  }
  .choice input:focus-visible + span {
    outline: 2px solid var(--acid);
    outline-offset: 2px;
  }
  .form__submit {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .form__status {
    min-height: 1.5em;
    font-size: var(--fs-sm);
    color: var(--bone-2);
  }
  .form__status.is-error {
    color: var(--ember);
  }
  .form__status.is-ok {
    color: var(--acid);
  }
  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Copy email
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.classList.add('is-done');
          btn.querySelector('.copy__label')!.textContent = 'Copied';
          setTimeout(() => {
            btn.classList.remove('is-done');
            btn.querySelector('.copy__label')!.textContent = 'Copy';
          }, 2200);
        } catch {
          location.href = `mailto:${btn.dataset.copy}`;
        }
      });
    });

    // Contact form: posts to a form service if one is configured, otherwise opens the visitor's email app.
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const say = (msg: string, kind: 'ok' | 'error' | '' = '') => {
      status.textContent = msg;
      status.className = `form__status${kind ? ` is-${kind}` : ''}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
      let firstBad: HTMLElement | undefined;
      for (const f of required) {
        const bad = !f.value.trim() || (f.type === 'email' && !/^\S+@\S+\.\S+$/.test(f.value));
        f.setAttribute('aria-invalid', String(bad));
        if (bad && !firstBad) firstBad = f;
      }
      if (firstBad) {
        say('Please fill in your name, a valid email and a message.', 'error');
        firstBad.focus();
        return;
      }
      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const subject = `${data.get('topic')} — from ${data.get('name')}`;
        const body = `${data.get('message')}\n\n— ${data.get('name')}${data.get('company') ? `, ${data.get('company')}` : ''}\n${data.get('email')}`;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        say('Opening your email app with the message ready to send…', 'ok');
        return;
      }

      label.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('Thank you — your note is on its way. I’ll reply soon.', 'ok');
      } catch {
        say(`Something went wrong sending that. Please email ${form.dataset.email} directly.`, 'error');
      } finally {
        label.textContent = 'Send message';
      }
    });
  });
</script>

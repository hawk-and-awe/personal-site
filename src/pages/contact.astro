---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Chris Hawk - Motion Designer">
  <!-- Hero Section -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Left Column - Text -->
        <div>
          <span class="text-hawk-500 font-medium text-sm uppercase tracking-wider reveal">Get in Touch</span>
          <h1 class="heading-xl mt-4 mb-6 reveal animate-delay-100">
            Let's create<br />
            <span class="text-gradient">something great.</span>
          </h1>
          <p class="text-xl text-dark-300 mb-8 reveal animate-delay-200">
            Have a project in mind? Want to collaborate? Or just want to say hello?
            I'd love to hear from you.
          </p>

          <!-- Contact Info -->
          <div class="space-y-6 reveal animate-delay-300">
            <a
              href="mailto:hawk@chrishawk.net"
              class="flex items-center gap-4 group"
            >
              <div class="w-12 h-12 rounded-xl bg-hawk-600/20 flex items-center justify-center group-hover:bg-hawk-600/30 transition-colors">
                <svg class="w-6 h-6 text-hawk-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-dark-400 text-sm">Email me at</p>
                <p class="text-white font-medium group-hover:text-hawk-400 transition-colors">hawk@chrishawk.net</p>
              </div>
            </a>

            <a
              href="https://instagram.com/chrishawk"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 group"
            >
              <div class="w-12 h-12 rounded-xl bg-hawk-600/20 flex items-center justify-center group-hover:bg-hawk-600/30 transition-colors">
                <svg class="w-6 h-6 text-hawk-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <p class="text-dark-400 text-sm">Follow me on</p>
                <p class="text-white font-medium group-hover:text-hawk-400 transition-colors">Instagram</p>
              </div>
            </a>

            <a
              href="https://linkedin.com/in/chrishawk"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 group"
            >
              <div class="w-12 h-12 rounded-xl bg-hawk-600/20 flex items-center justify-center group-hover:bg-hawk-600/30 transition-colors">
                <svg class="w-6 h-6 text-hawk-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <div>
                <p class="text-dark-400 text-sm">Connect on</p>
                <p class="text-white font-medium group-hover:text-hawk-400 transition-colors">LinkedIn</p>
              </div>
            </a>
          </div>

          <!-- Lottie Animation Placeholder -->
          <div class="mt-12 hidden lg:block reveal animate-delay-400">
            <div id="lottie-contact" class="w-64 h-64 bg-dark-900/50 rounded-2xl border border-dark-800 flex items-center justify-center">
              <div class="text-center">
                <span class="text-6xl">📬</span>
                <p class="text-dark-500 text-sm mt-4">Lottie Animation</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Form -->
        <div class="reveal-right">
          <div class="card p-6 md:p-8">
            <h2 class="heading-md mb-6">Send a message</h2>

            <form
              id="contact-form"
              action="https://formspree.io/f/your-form-id"
              method="POST"
              class="space-y-6"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-dark-300 text-sm font-medium mb-2">
                    First Name <span class="text-hawk-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    required
                    class="w-full px-4 py-3 bg-dark-800 border border-dark-700 rounded-lg text-white placeholder-dark-500 focus:outline-none focus:border-hawk-500 focus:ring-1 focus:ring-hawk-500 transition-colors"
                    placeholder="John"
                  />
                </div>
                <div>
                  <label for="lastName" class="block text-dark-300 text-sm font-medium mb-2">
                    Last Name <span class="text-hawk-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    required
                    class="w-full px-4 py-3 bg-dark-800 border border-dark-700 rounded-lg text-white placeholder-dark-500 focus:outline-none focus:border-hawk-500 focus:ring-1 focus:ring-hawk-500 transition-colors"
                    placeholder="Doe"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-dark-300 text-sm font-medium mb-2">
                  Email <span class="text-hawk-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-700 rounded-lg text-white placeholder-dark-500 focus:outline-none focus:border-hawk-500 focus:ring-1 focus:ring-hawk-500 transition-colors"
                  placeholder="john@example.com"
                />
              </div>

              <div>
                <label for="subject" class="block text-dark-300 text-sm font-medium mb-2">
                  Subject
                </label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-700 rounded-lg text-white focus:outline-none focus:border-hawk-500 focus:ring-1 focus:ring-hawk-500 transition-colors"
                >
                  <option value="general">General Inquiry</option>
                  <option value="project">Project Opportunity</option>
                  <option value="collaboration">Collaboration</option>
                  <option value="job">Job Opportunity</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-dark-300 text-sm font-medium mb-2">
                  Message <span class="text-hawk-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-700 rounded-lg text-white placeholder-dark-500 focus:outline-none focus:border-hawk-500 focus:ring-1 focus:ring-hawk-500 transition-colors resize-none"
                  placeholder="Tell me about your project or just say hi..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn-primary w-full"
              >
                <span id="btn-text">Send Message</span>
                <svg id="btn-icon" class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                <svg id="btn-spinner" class="hidden w-5 h-5 ml-2 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>

              <p class="text-dark-500 text-sm text-center">
                I'll get back to you within 24-48 hours.
              </p>
            </form>

            <!-- Success Message -->
            <div id="success-message" class="hidden text-center py-8">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-hawk-600/20 flex items-center justify-center">
                <svg class="w-8 h-8 text-hawk-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="heading-sm text-white mb-2">Message Sent!</h3>
              <p class="text-dark-400">
                Thanks for reaching out. I'll get back to you soon!
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map or Additional Section -->
  <section class="py-16 bg-dark-900/30">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-hawk-500 font-medium text-sm uppercase tracking-wider reveal">Location</span>
        <h2 class="heading-md mt-2 mb-4 reveal animate-delay-100">Based in Oklahoma</h2>
        <p class="text-dark-400 reveal animate-delay-200">
          Working remotely and available for projects worldwide.
          Open to on-site work for the right opportunity.
        </p>
      </div>
    </div>
  </section>

  <script>
    // Form submission handling
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');
    const successMessage = document.getElementById('success-message');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Show loading state
      if (btnText) btnText.textContent = 'Sending...';
      btnIcon?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');

      // Simulate form submission (replace with actual form handler)
      try {
        // For actual submission, uncomment:
        // const response = await fetch(form.action, {
        //   method: 'POST',
        //   body: new FormData(form),
        //   headers: { 'Accept': 'application/json' }
        // });

        // Simulated delay
        await new Promise(resolve => setTimeout(resolve, 1500));

        // Show success
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');

      } catch (error) {
        // Reset button on error
        if (btnText) btnText.textContent = 'Send Message';
        btnIcon?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    });
  </script>
</Layout>

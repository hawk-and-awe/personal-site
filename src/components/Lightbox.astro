---
import Icon from './Icon.astro';
---

<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" data-lb-img />
    <figcaption class="lightbox__caption mono">
      <span data-lb-caption></span>
      <span class="lightbox__count" data-lb-count></span>
    </figcaption>
  </figure>
  <button class="lightbox__btn lightbox__prev" type="button" data-lb-prev aria-label="Previous image">
    <Icon name="arrow" />
  </button>
  <button class="lightbox__btn lightbox__next" type="button" data-lb-next aria-label="Next image">
    <Icon name="arrow" />
  </button>
  <button class="lightbox__btn lightbox__close" type="button" data-lb-close aria-label="Close">
    <Icon name="close" />
  </button>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: rgb(8 7 6 / 0.96);
    color: var(--bone);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.35s var(--ease-out);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from { opacity: 0; }
  }
  .lightbox__figure {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    padding: 4.5rem clamp(0.75rem, 6vw, 6rem) 1.5rem;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 30px 120px -30px #000;
  }
  .lightbox__caption {
    display: flex;
    gap: 1.25rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--bone-2);
    max-width: 70ch;
    text-align: center;
  }
  .lightbox__count {
    color: var(--bone-3);
    white-space: nowrap;
  }
  .lightbox__btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: rgb(11 10 9 / 0.6);
    font-size: 1.15rem;
    transition: background-color 0.2s, color 0.2s;
  }
  .lightbox__btn:hover {
    background: var(--bone);
    color: var(--ink);
  }
  .lightbox__prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__prev :global(svg) {
    rotate: 180deg;
  }
  .lightbox__next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox[data-single] .lightbox__prev,
  .lightbox[data-single] .lightbox__next {
    display: none;
  }
  @media (max-width: 700px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>

<script>
  // Any element with [data-lightbox="group"] and data-full/data-caption opens here.
  let items: HTMLElement[] = [];
  let index = 0;
  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel);

  function show(i: number) {
    const dialog = $<HTMLDialogElement>('#lightbox');
    const img = $<HTMLImageElement>('[data-lb-img]');
    if (!dialog || !img || !items.length) return;
    index = (i + items.length) % items.length;
    const item = items[index];
    img.src = item.dataset.full ?? '';
    img.alt = item.dataset.alt ?? '';
    $('[data-lb-caption]')!.textContent = item.dataset.caption ?? '';
    $('[data-lb-count]')!.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
    dialog.toggleAttribute('data-single', items.length < 2);
    // Warm the neighbours so arrowing through feels instant.
    [index + 1, index - 1].forEach((n) => {
      const next = items[(n + items.length) % items.length];
      if (next?.dataset.full) new Image().src = next.dataset.full;
    });
  }

  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const opener = t.closest<HTMLElement>('[data-lightbox]');
    const dialog = $<HTMLDialogElement>('#lightbox');
    if (opener && dialog) {
      e.preventDefault();
      items = [...document.querySelectorAll<HTMLElement>(`[data-lightbox="${opener.dataset.lightbox}"]`)];
      show(items.indexOf(opener));
      dialog.showModal();
      return;
    }
    if (t.closest('[data-lb-next]')) show(index + 1);
    else if (t.closest('[data-lb-prev]')) show(index - 1);
    else if (t.closest('[data-lb-close]') || (t instanceof HTMLDialogElement && t.id === 'lightbox')) dialog?.close();
  });
  document.addEventListener('keydown', (e) => {
    if (!$<HTMLDialogElement>('#lightbox')?.open) return;
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === 'ArrowLeft') show(index - 1);
  });
  document.addEventListener('astro:before-swap', () => $<HTMLDialogElement>('#lightbox')?.close());
</script>

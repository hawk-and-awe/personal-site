  class?: string;
  draw?: boolean;
  /** Seconds to wait before drawing starts. */
  delay?: number;
  title?: string;
  [attr: string]: unknown;
}
// `rest` carries the parent's scoped-style attribute, so parents can size and position the emblem.
const { class: className, draw = false, delay = 0, title, ...rest } = Astro.props;

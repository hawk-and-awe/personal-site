  class:list={['hawk', { 'hawk--draw': draw }, className]}
  viewBox="100 60 260 480"
  style={`--hawk-delay:${delay}s`}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  {...rest}

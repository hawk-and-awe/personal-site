---
/**
 * The hawk, printed like a woodcut — an acid silhouette with details "carved" out in ink.
 * Two poses: perched on a film reel (with a falconer's jess and bell), or in flight.
 * `draw` presses the print on, then carves the lines in.
 */
import { site } from '../site.config';

interface Props {
  class?: string;
  /** Defaults to `site.hawk` in site.config.ts. */
  pose?: 'perched' | 'flight';
  draw?: boolean;
  /** Seconds to wait before the print starts. */
  delay?: number;
  /** Woodcut ink texture; turn off for small renderings. */
  texture?: boolean;
  title?: string;
  [attr: string]: unknown;
}
// `rest` carries the parent's scoped-style attribute, so parents can size and position the bird.
const { class: className, pose = site.hawk, draw = false, delay = 0, texture = true, title, ...rest } = Astro.props;
---

<svg
  class:list={['hawk', `hawk--${pose}`, { 'hawk--draw': draw }, className]}
  viewBox={pose === 'flight' ? '96 6 450 430' : '100 60 260 480'}
  style={`--hawk-delay:${delay}s`}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  {...rest}
>
  <g filter={texture ? 'url(#woodcut)' : undefined}>
    {

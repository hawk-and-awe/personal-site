<style>
  .hawk {
    --hawk-stroke: var(--acid);
    --hawk-fill: var(--ink);
    overflow: visible;
  }
  .hawk :global(path) {
    fill: none;
    stroke: var(--hawk-stroke);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hawk :global(.head-g path) {
    stroke-width: 3.85;
  }
  .hawk :global(.thin) {
    stroke-width: 2.5;
  }
  .hawk :global(.fill) {
    fill: var(--hawk-fill);
  }
  .hawk :global(.dot) {
    fill: var(--hawk-stroke);
    stroke: none;
  }
  .hawk--draw :global(path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hawk-ink 1.5s var(--ease-in-out) both;
    animation-delay: calc(var(--hawk-delay) + var(--d, 0s));
  }
  .hawk--draw :global(.fill),
  .hawk--draw :global(.dot) {
    fill-opacity: 0;
    animation-name: hawk-ink, hawk-fill;
  }
  @keyframes hawk-ink {
    0% { stroke-dashoffset: 1; stroke-opacity: 0; }
    2% { stroke-opacity: 1; }
    100% { stroke-dashoffset: 0; stroke-opacity: 1; }
  }
  @keyframes hawk-fill {
    0% { fill-opacity: 0; }
    100% { fill-opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hawk--draw :global(path) {
      animation: none;
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }
</style>

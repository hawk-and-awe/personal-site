---
/**
 * The hawk: a perched raptor gripping a film reel, printed like a woodcut —
 * an acid silhouette with details "carved" out in ink, wearing a falconer's jess and bell.
 * `draw` presses the print on, then carves the lines in.
 */
interface Props {
  class?: string;
  draw?: boolean;
  /** Seconds to wait before the print starts. */
  delay?: number;
  /** Woodcut ink texture; turn off for small renderings. */
  texture?: boolean;
  title?: string;
  [attr: string]: unknown;
}
// `rest` carries the parent's scoped-style attribute, so parents can size and position the bird.
const { class: className, draw = false, delay = 0, texture = true, title, ...rest } = Astro.props;
---


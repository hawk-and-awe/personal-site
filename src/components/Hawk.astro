<style>
  .hawk {
    --hawk-print: var(--acid);
    --hawk-ink: var(--ink);
    overflow: visible;
  }
  .hawk :global(path) {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .print :global(path) {
    fill: var(--hawk-print);
    stroke: var(--hawk-print);
    stroke-width: 2.5;
  }
  .carve :global(path) {
    fill: none;
    stroke: var(--hawk-ink);
    stroke-width: 3.4;
  }
  .carve :global(.ink) {
    fill: var(--hawk-ink);
    stroke: none;
  }
  .carve :global(.glint) {
    fill: var(--hawk-print);
    stroke: none;
  }
  .carve :global(.fine) { stroke-width: 2.2; }
  .carve :global(.thin) { stroke-width: 2; }
  .carve :global(.edge) { stroke-width: 3.6; }
  .carve :global(.quill) { stroke-width: 3; }
  .carve :global(.scale) { stroke-width: 2.8; }
  .carve :global(.eye) { stroke-width: 3.4; }
  .carve :global(.band) { stroke-width: 9; stroke-linecap: butt; }
  .carve :global(.toe-under) { stroke-width: 12; }
  .carve :global(.toe) { stroke: var(--hawk-print); stroke-width: 6.5; }
  .carve :global(.claw) { stroke: var(--hawk-print); stroke-width: 4; }
  .carve :global(.jess) { stroke: var(--hawk-print); stroke-width: 3; }
  .carve :global(.shaft) { stroke-width: 2.4; }
  .carve :global(.bar) { stroke-width: 5; stroke-linecap: butt; }
  .carve :global(.sep) { stroke-width: 2.2; }
  .carve :global(.barb) { stroke-width: 1.8; }

  /* Print: the block is pressed onto the page… */
  .hawk--draw .print {
    transform-box: fill-box;
    transform-origin: 50% 60%;
    animation: hawk-press 0.7s var(--ease-out) both;
    animation-delay: var(--hawk-delay);
  }
  /* …then the lines are carved in. */
  .hawk--draw .carve :global(path) {
    stroke-dasharray: 1;
    animation: hawk-carve 0.9s var(--ease-in-out) both;
    animation-delay: calc(var(--hawk-delay) + var(--d, 0s));
  }
  .hawk--draw .carve :global(.ink),
  .hawk--draw .carve :global(.glint) {
    animation-name: hawk-stamp;
    animation-duration: 0.45s;
  }
  @keyframes hawk-press {
    0% { opacity: 0; transform: scale(1.05); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes hawk-carve {
    0% { stroke-dashoffset: 1; opacity: 0; }
    2% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes hawk-stamp {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hawk--draw .print,
    .hawk--draw .carve :global(path) {
      animation: none;
      stroke-dasharray: none;
    }
  }
</style>

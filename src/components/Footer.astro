---
import Hawk from './Hawk.astro';
import Icon from './Icon.astro';
import { site } from '../site.config';
import { roman } from '../lib/video';
import { getNav } from '../lib/nav';

interface Props {
  /** Hide the big email call-to-action (e.g. on the contact page, which already has one). */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const nav = await getNav();
---

<footer class="site-footer">
  <div class="container">
    {
      cta && (
        <div class="footer__cta">
          <Hawk class="footer__hawk" />
          <div class="footer__ask">
            <p class="kicker kicker--acid">Correspondence</p>
            <p class="footer__line">Have a story that needs to fly?</p>
            <a class="footer__email" href={`mailto:${site.email}`}>
              <span class="link-line">{site.email}</span>
              <Icon name="arrow-up-right" />
            </a>
          </div>
        </div>
      )
    }

    <div class="footer__grid">
      <nav aria-label="Footer">
        <p class="kicker">Index</p>
        <ul role="list">
          <li><a href="/" class="link-line">Home</a></li>
          {nav.map((item) => <li><a href={item.href} class="link-line">{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="kicker">Elsewhere</p>
        <ul role="list">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="link-line">{s.label}</a>
              </li>
            ))
          }
          <li><a href={site.resumeUrl} target="_blank" rel="noopener" class="link-line">Résumé (PDF)</a></li>
        </ul>
      </div>
      <div>
        <p class="kicker">Local time</p>
        <p class="mono footer__clock"><span data-clock>—</span> · {site.location}</p>
      </div>
    </div>

    <div class="footer__base">
      <p class="mono">© {roman(year)} {site.name}</p>
      <a href="#main" class="mono footer__top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: clamp(5rem, 10vw, 8rem) 2rem;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .footer__cta {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .footer__hawk {
    width: auto;
    height: clamp(12rem, 20vw, 17rem);
  }
  .footer__ask {
    display: grid;
    gap: 1rem;
  }
  .footer__line {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
    font-size: clamp(1.75rem, 1rem + 4.2vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--acid);
  }
  .footer__email :global(svg) {
    width: 0.7em;
    height: 0.7em;
    transition: transform 0.4s var(--ease-out);
  }
  .footer__email:hover :global(svg) {
    transform: translate(0.08em, -0.08em);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .footer__grid ul {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.9rem;
  }
  .footer__grid a {
    color: var(--bone-2);
  }
  .footer__grid a:hover {
    color: var(--bone);
  }
  .footer__clock {
    margin-top: 0.9rem;
    font-size: var(--fs-sm);
    color: var(--bone-2);
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--bone-3);
  }
  .footer__top:hover {
    color: var(--acid);
  }
  @media (max-width: 720px) {
    .footer__cta {
      grid-template-columns: 1fr;
    }
    .footer__hawk {
      height: 12rem;
    }
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__grid > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', hour: 'numeric', minute: '2-digit' });
  let timer: number | undefined;
  function tick() {
    document.querySelectorAll('[data-clock]').forEach((el) => (el.textContent = fmt.format(new Date())));
  }
  document.addEventListener('astro:page-load', () => {
    tick();
    clearInterval(timer);
    timer = window.setInterval(tick, 15_000);
  });
</script>

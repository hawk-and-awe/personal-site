---
import Icon from './Icon.astro';
import PlayerControls from './PlayerControls.astro';
---

<dialog id="theater" class="theater" aria-labelledby="theater-title">
  <div class="theater__panel">
    <header class="theater__bar">
      <p class="kicker kicker--acid">Now playing</p>
      <h2 id="theater-title" class="theater__title" data-theater-title>Film</h2>
      <a class="btn theater__link" href="/work" data-theater-link hidden>
        Case study <Icon name="arrow" />
      </a>
      <button class="theater__close" type="button" data-theater-close aria-label="Close player">
        <Icon name="close" />
      </button>
    </header>
    <div class="theater__stage" data-theater-stage></div>
  </div>
  <!-- Self-hosted films get the site's own controls; players.ts clones these in. -->
  <template data-controls-template><PlayerControls /></template>
</dialog>

<style>
  .theater {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: clamp(0.75rem, 3vw, 2.5rem);
    border: 0;
    background: rgb(8 7 6 / 0.94);
    color: var(--bone);
    backdrop-filter: blur(10px);
  }
  .theater[open] {
    display: grid;
    place-items: center;
    animation: theater-in 0.45s var(--ease-out);
  }
  .theater::backdrop {
    background: transparent;
  }
  @keyframes theater-in {
    from { opacity: 0; }
  }
  .theater__panel {
    width: min(100%, 1400px, calc((100dvh - 9rem) * 16 / 9));
    animation: panel-in 0.6s var(--ease-out);
  }
  @keyframes panel-in {
    from { transform: translateY(24px) scale(0.98); }
  }
  .theater__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .theater__title {
    flex: 1;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .theater__link {
    min-height: 2.5rem;
  }
  .theater__link[hidden] {
    display: none;
  }
  .theater__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    font-size: 1.1rem;
    transition: background-color 0.2s, color 0.2s;
  }
  .theater__close:hover {
    background: var(--bone);
    color: var(--ink);
  }
  .theater__stage {
    position: relative;
    aspect-ratio: var(--aspect, 16/9);
    max-height: calc(100dvh - 9rem);
    margin-inline: auto;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line);
  }
  .theater__stage :global(iframe),
  .theater__stage :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Self-hosted films: the video keeps the frame, the controls sit underneath it. */
  .theater__stage.has-controls {
    aspect-ratio: auto;
    max-height: none;
    overflow: visible;
    background: none;
    border-radius: 0;
    box-shadow: none;
  }
  .theater__stage.has-controls :global(video) {
    position: static;
    height: auto;
    aspect-ratio: var(--aspect, 16/9);
    max-height: calc(100dvh - 13rem);
    margin-inline: auto;
    object-fit: contain;
    background: #000;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }
  .theater__stage :global([data-player]:fullscreen) {
    display: grid;
    background: #000;
  }
  .theater__stage :global([data-player]:fullscreen video) {
    max-height: none;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    box-shadow: none;
  }
  @media (max-width: 600px) {
    .theater__kicker,
    .theater__bar .kicker {
      display: none;
    }
  }
</style>

<style is:global>
  html.theater-open {
    overflow: hidden;
  }
</style>

<script>
  // Theater + inline players share one module; loading it here makes "Watch" work on every page.
  import { initPlayers } from '../scripts/players';
  initPlayers();
</script>
